# Example machine-global git configuration (~/.gitconfig)
# Sets default SSH signing format and default branch

[user]
    name = Your Name
    email = maintainer@example.com

[init]
    defaultBranch = main

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[core]
    # Point to global hooks (which chain to repo hooks)
    hooksPath = ~/.config/git/hooks
