# Machine-global git configuration (rendered to {{ user_home }}/.gitconfig)
# Enforces SSH signing, allowed_signers verification, and chained global hooks

[user]
    name = {{ git_user_name }}
    email = {{ git_email }}
{% if default_signing_key is defined %}
    signingkey = {{ default_signing_key }}
{% endif %}

[init]
    defaultBranch = main

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = {{ xdg_config }}/git/allowed_signers

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[core]
    # Point to global hooks (which run global secret scans and chain to repo hooks)
    hooksPath = {{ xdg_config }}/git/hooks
